.venv/
.env
.env.*
__pycache__/
*.pyc
.pytest_cache/
.cache/
.tutor/
data/
checkpoints/
models/
*.mp4
# the three videos the README and the Pages site play are kept, in docs/ only
!docs/*.mp4
third_party/SO-ARM100/
# Working drafts for the submission (form text, video script, slide outline) stay local.
docs/submission.md
docs/video_script.md
docs/slides.md
docs/narration.md
# out/: generated artefacts stay local (checkpoints, videos, caches); the small result files every number in the
# README comes from are kept (evaluation summaries, per-seed rows, benchmark tables).
out/*
!out/eval/
out/eval/**/*.*
# folders whose names contain a dot (stress_1.0, shape_0.2) are folders, not files: keep them visible
!out/eval/**/
!out/eval/**/*.json
!out/eval/**/*.csv
!out/eval/**/*.md
!out/benchmark/
out/benchmark/*.*
!out/benchmark/*.json
!out/benchmark/*.md

# Copy this file to .env and fill in the key. .env is git-ignored; this template is committed.
#
#     cp .env.example .env                  # macOS / Linux
#     Copy-Item .env.example .env           # Windows PowerShell
#
# Only the voice commands need this. Speech is the one part of the system that leaves the machine, and
# nothing needs a key unless you ask for it: typed commands run entirely on the local CPU.
#
#     make agent CMD="set the table" SEED=3     # typed, no key required
#     make voice SEED=3                         # spoken, needs the key below
#
# A key is free from https://portal.speechmatics.com/ and the free tier covers every demo in this repo.
# The key is read from the real environment first and only then from this file, so an exported shell
# variable always wins. Never commit a filled-in .env.

SPEECHMATICS_API_KEY=
